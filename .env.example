# Modelo de variáveis de ambiente do NextUp.
#
# Copie para `.env` e ajuste o que precisar. O arquivo `.env` está no .gitignore
# e nunca deve ser commitado — é o lugar de configuração específica da máquina
# e, futuramente, de segredos.
#
# Todos os valores abaixo são os padrões definidos em `src/nextup/config.py`.
# Comentados, porque o projeto funciona sem nenhum deles.

# --- API externa -----------------------------------------------------------
# NEXTUP_API_BASE_URL=https://api.themeparks.wiki/v1
# NEXTUP_USER_AGENT=NextUp/0.1 (+https://github.com/GabrielFDA7/nextup)
# NEXTUP_REQUEST_TIMEOUT=10.0
# NEXTUP_MAX_RETRIES=3

# --- Cache (em segundos) ---------------------------------------------------
# Fila e status mudam o tempo todo; catálogo de atrações quase nunca muda.
# NEXTUP_LIVE_TTL=60
# NEXTUP_CATALOG_TTL=86400

# --- Parâmetros de caminhada -----------------------------------------------
# Velocidade em m/s. Menor que os 1,4 m/s de rua: parque é lotado.
# NEXTUP_WALKING_SPEED=1.1
# Correção da linha reta para o trajeto real (trilhas fazem curva).
# NEXTUP_WINDING_FACTOR=1.3

# --- Recomendação ----------------------------------------------------------
# NEXTUP_RESULT_LIMIT=5
# Magic Kingdom, Walt Disney World.
# NEXTUP_DEFAULT_PARK=75ea578a-adc8-4116-a54d-dccb60765ef9
