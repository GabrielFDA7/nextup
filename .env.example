# Modelo de variáveis de ambiente do NextUp.
#
# Copie para `.env` e ajuste o que precisar. O arquivo `.env` está no .gitignore
# e nunca deve ser commitado — é o lugar de configuração específica da máquina
# e, futuramente, de segredos.
#
# Todos os valores abaixo são os padrões definidos em `src/nextup/config.py`.
# Comentados, porque o projeto funciona sem nenhum deles.

# --- API externa -----------------------------------------------------------
# NEXTUP_API_BASE_URL=https://api.themeparks.wiki/v1
# NEXTUP_USER_AGENT=NextUp/0.1 (+https://github.com/GabrielFDA7/nextup)
# NEXTUP_REQUEST_TIMEOUT=10.0
# NEXTUP_MAX_RETRIES=3
# Espera da 1a retentativa; as seguintes dobram (0,5s -> 1s -> 2s).
# NEXTUP_BACKOFF_BASE=0.5

# --- Cache (em segundos) ---------------------------------------------------
# Fila e status mudam o tempo todo; catálogo de atrações quase nunca muda.
# NEXTUP_LIVE_TTL=60
# NEXTUP_CATALOG_TTL=86400

# --- Parâmetros de caminhada -----------------------------------------------
# Velocidade em m/s. Menor que os 1,4 m/s de rua: parque é lotado.
# NEXTUP_WALKING_SPEED=1.1
# Correção da linha reta para o trajeto real (trilhas fazem curva).
# NEXTUP_WINDING_FACTOR=1.3

# --- Recomendação ----------------------------------------------------------
# NEXTUP_RESULT_LIMIT=5
# Magic Kingdom, Walt Disney World.
# NEXTUP_DEFAULT_PARK=75ea578a-adc8-4116-a54d-dccb60765ef9

# --- Banco de dados: histórico de filas (Fase 6) ---------------------------
# O padrão é um SQLite em arquivo, na raiz: quem clona o repositório roda o
# projeto sem instalar banco nenhum.
# NEXTUP_DATABASE_URL=sqlite+aiosqlite:///./nextup.db
#
# Em produção, a URL de um Postgres gerenciado. O prefixo `+asyncpg` escolhe o
# driver assíncrono; sem ele o SQLAlchemy usaria o síncrono e travaria o servidor
# a cada gravação. Se a plataforma entregar a URL como `postgres://` ou
# `postgresql://`, o `normalize_database_url` do config.py conserta sozinho.
# NEXTUP_DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/nextup
#
# ATENÇÃO: a URL de produção contém senha. Ela vive nas variáveis de ambiente do
# Render, nunca em arquivo commitado — e é por isso que o alembic.ini está com a
# `sqlalchemy.url` vazia.

# Dias de histórico a manter. Um parque gera ~6 mil linhas por dia; guardar para
# sempre um dado que ninguém consulta é só conta crescendo.
# NEXTUP_HISTORY_RETENTION_DAYS=90
